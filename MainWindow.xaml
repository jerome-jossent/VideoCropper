<Window x:Class="VideoCropper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:VideoCropper.Controls"
        Title="Video Cropper" Icon="Images/VideoCropper.ico" Width="1280" Height="940" MinWidth="950" MinHeight="760"
        AllowDrop="True" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"/>
    </Window.TaskbarItemInfo>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="WorkArea" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barre d'ouverture -->
            <DockPanel Grid.Row="0">
                <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="Aucune vidéo chargée (Ctrl+O pour ouvrir un fichier)"/>
            </DockPanel>

            <!-- Aperçu + ROI (et cadre d'accueil tant qu'aucune vidéo n'est chargée) -->
            <Grid Grid.Row="1" Margin="0,10">
                <ctl:RoiSelector x:Name="Roi"/>
                <Border x:Name="DropZone" Background="#FF1E1E1E" Cursor="Hand" MouseLeftButtonUp="DropZone_Click">
                    <Grid>
                        <Rectangle Margin="28" Stroke="#888888" StrokeThickness="2" StrokeDashArray="6 4"
                                   RadiusX="12" RadiusY="12"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="Images/video_load.png" Height="96" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Cliquez ici pour charger une vidéo" FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" Margin="0,16,0,4"/>
                            <TextBlock Text="ou glissez-déposez un fichier vidéo dans cette fenêtre" FontSize="14"
                                       Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Timeline -->
            <StackPanel Grid.Row="2">
                <ctl:TimelineBar x:Name="Timeline" Height="66" Margin="0,0,0,6">
                    <ctl:TimelineBar.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Définir le début (position actuelle)" Click="SetStart_Click">
                                <MenuItem.Icon>
                                    <Image Source="Images/VideoCropper_deb.png" Width="20" Height="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Définir la fin (position actuelle)" Click="SetEnd_Click">
                                <MenuItem.Icon>
                                    <Image Source="Images/VideoCropper_fin.png" Width="20" Height="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ctl:TimelineBar.ContextMenu>
                </ctl:TimelineBar>

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource IconButton}" HorizontalAlignment="Left"
                            Click="SetStart_Click" ToolTip="Définir le début (I)">
                        <Image Source="Images/VideoCropper_deb.png" Style="{StaticResource IconImage}"/>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="◀ Image" Click="PrevFrame_Click"/>
                        <Button x:Name="PlayBtn" Content="▶ Lecture" MinWidth="100" Click="Play_Click"
                                ToolTip="Lecture / pause (Espace)"/>
                        <Button Content="Image ▶" Click="NextFrame_Click" Margin="0"/>
                        <Button x:Name="MuteBtn" Content="🔊" MinWidth="36" Margin="20,0,6,0" Click="Mute_Click"
                                ToolTip="Couper / rétablir le son"/>
                        <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.8"
                                VerticalAlignment="Center" Focusable="False" ToolTip="Volume"
                                ValueChanged="Volume_Changed"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            Click="SetEnd_Click" ToolTip="Définir la fin (O)">
                        <Image Source="Images/VideoCropper_fin.png" Style="{StaticResource IconImage}"/>
                    </Button>
                </Grid>

                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Click="ResetRange_Click" ToolTip="Réinitialiser la durée">
                        <Image Source="Images/video_reset.png" Style="{StaticResource IconImage}"/>
                    </Button>
                    <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontWeight="Bold"/>
                    <TextBlock x:Name="TimeText" DockPanel.Dock="Left" VerticalAlignment="Center" FontFamily="Consolas"/>
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Début" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="StartBox" Width="100" FontFamily="Consolas" VerticalContentAlignment="Center"
                                 ToolTip="hh:mm:ss.fff, mm:ss ou secondes — Entrée pour valider"
                                 LostFocus="StartBox_LostFocus" KeyDown="Field_KeyDown"/>
                        <TextBlock Text="Fin" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox x:Name="EndBox" Width="100" FontFamily="Consolas" VerticalContentAlignment="Center"
                                 ToolTip="hh:mm:ss.fff, mm:ss ou secondes — Entrée pour valider"
                                 LostFocus="EndBox_LostFocus" KeyDown="Field_KeyDown"/>
                        <TextBlock x:Name="RangeText" VerticalAlignment="Center" Margin="16,0,0,0" FontFamily="Consolas"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- Options d'export -->
            <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Encodeur :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="EncoderBox" Width="300" DisplayMemberPath="Label"
                                  SelectionChanged="Options_Changed" DropDownClosed="Combo_DropDownClosed" Margin="0,0,16,0"/>
                        <TextBlock Text="Débit :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="BitrateModeBox" Width="260" SelectedIndex="0"
                                  SelectionChanged="Options_Changed" DropDownClosed="Combo_DropDownClosed" Margin="0,0,8,0">
                            <ComboBoxItem Content="Proportionnel à la surface de la ROI"/>
                            <ComboBoxItem Content="Identique à la source"/>
                            <ComboBoxItem Content="Personnalisé (Mbps)"/>
                            <ComboBoxItem Content="Qualité constante (CRF)"/>
                        </ComboBox>
                        <TextBox x:Name="ValueBox" Width="60" Text="20" VerticalContentAlignment="Center"
                                 TextChanged="ValueBox_TextChanged" KeyDown="Field_KeyDown" Visibility="Collapsed"/>
                        <TextBlock x:Name="ValueLabel" VerticalAlignment="Center" Margin="6,0,16,0" Visibility="Collapsed"/>
                        <CheckBox x:Name="AudioCheck" Content="Conserver l'audio" IsChecked="True"
                                  VerticalAlignment="Center" Focusable="False"/>
                    </WrapPanel>

                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="Rotation :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="RotationBox" Width="190" SelectedIndex="0" Margin="0,0,24,0"
                                  SelectionChanged="Rotation_Changed" DropDownClosed="Combo_DropDownClosed">
                            <ComboBoxItem Content="Aucune"/>
                            <ComboBoxItem Content="90° (sens horaire)"/>
                            <ComboBoxItem Content="180°"/>
                            <ComboBoxItem Content="-90° (sens anti-horaire)"/>
                        </ComboBox>
                        <TextBlock Text="Redimensionner :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ResizeBox" Width="150" SelectedIndex="0" Margin="0,0,10,0"
                                  SelectionChanged="Resize_Changed" DropDownClosed="Combo_DropDownClosed">
                            <ComboBoxItem Content="Taille d'origine"/>
                            <ComboBoxItem Content="75 %"/>
                            <ComboBoxItem Content="50 %"/>
                            <ComboBoxItem Content="25 %"/>
                            <ComboBoxItem Content="Personnalisée"/>
                        </ComboBox>
                        <TextBlock Text="Largeur" VerticalAlignment="Center"/>
                        <TextBox x:Name="OutWBox" Width="64" Margin="4,0,6,0" VerticalContentAlignment="Center"
                                 LostFocus="OutW_LostFocus" KeyDown="Field_KeyDown"/>
                        <TextBlock Text="×" VerticalAlignment="Center"/>
                        <TextBlock Text="Hauteur" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBox x:Name="OutHBox" Width="64" Margin="4,0,8,0" VerticalContentAlignment="Center"
                                 LostFocus="OutH_LostFocus" KeyDown="Field_KeyDown"/>
                        <TextBlock Text="(ratio conservé)" Foreground="Gray" VerticalAlignment="Center"/>
                    </WrapPanel>

                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="ROI (pixels de l'image affichée) :" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="X" VerticalAlignment="Center"/>
                        <TextBox x:Name="RoiXBox" Width="64" Margin="4,0,12,0" VerticalContentAlignment="Center"
                                 LostFocus="RoiField_LostFocus" KeyDown="Field_KeyDown"/>
                        <TextBlock Text="Y" VerticalAlignment="Center"/>
                        <TextBox x:Name="RoiYBox" Width="64" Margin="4,0,12,0" VerticalContentAlignment="Center"
                                 LostFocus="RoiField_LostFocus" KeyDown="Field_KeyDown"/>
                        <TextBlock Text="Largeur" VerticalAlignment="Center"/>
                        <TextBox x:Name="RoiWBox" Width="64" Margin="4,0,12,0" VerticalContentAlignment="Center"
                                 LostFocus="RoiField_LostFocus" KeyDown="Field_KeyDown"/>
                        <TextBlock Text="Hauteur" VerticalAlignment="Center"/>
                        <TextBox x:Name="RoiHBox" Width="64" Margin="4,0,12,0" VerticalContentAlignment="Center"
                                 LostFocus="RoiField_LostFocus" KeyDown="Field_KeyDown"/>
                        <Button Content="Effacer la ROI" Click="ClearRoi_Click" Margin="0,0,16,0"/>
                        <TextBlock x:Name="TargetText" VerticalAlignment="Center"/>
                    </WrapPanel>

                    <TextBlock Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Dessinez la ROI à la souris sur l'image (un clic simple l'efface) ou saisissez ses valeurs. Sans ROI, la découpe se fait sans ré-encodage ; avec une ROI, la vidéo est ré-encodée. Molette = zoom (image et timeline), clic droit ou milieu + glisser = déplacer la vue, clic droit simple sur la timeline = menu début/fin. Raccourcis : Espace = lecture/pause, ←/→ image par image (Maj = 1 s), I = début, O = fin."/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Progression + Exporter / Annuler -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <Button x:Name="ExportBtn" Content="Exporter…" DockPanel.Dock="Right" Margin="12,0,0,0"
                    MinWidth="130" Padding="20,7" FontWeight="Bold" Click="ExportCancel_Click"/>
            <TextBlock x:Name="Status" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="160"/>
            <ProgressBar x:Name="Bar" Height="18" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
