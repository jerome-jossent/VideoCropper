<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>VideoCropper</RootNamespace>
    <AssemblyName>VideoCropper</AssemblyName>
    <ApplicationIcon>Images\VideoCropper.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Optionnel : placez ffmpeg.exe et ffprobe.exe dans un dossier "ffmpeg" à côté du .csproj
       pour qu'ils soient copiés automatiquement à côté de l'exécutable. -->
  <ItemGroup>
    <None Include="ffmpeg\*.exe" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Images\*.png;Images\*.ico" />
  </ItemGroup>
</Project>
